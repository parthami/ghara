[Unit]
Description=Ghara TSX and Python Process
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=parth
Group=parth
WorkingDirectory=/home/parth/ghara

# Ensure Bun and Node binaries are in PATH
Environment=PATH=/home/parth/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production

# Execute Bun directly
ExecStart=/home/parth/.bun/bin/bun run node/ghara.ts

# Production resilience settings for Pi
Restart=always
RestartSec=10s

# Logging controls (prevents filling up SD card with massive log files)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=my-app

[Install]
WantedBy=multi-user.target